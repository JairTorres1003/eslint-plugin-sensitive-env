{
  "name": "eslint-plugin-sensitive-env",
  "description": "ESLint plugin to prevent sensitive values from being hardcoded in the codebase",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "sensitive",
    "env",
    "secrets",
    "security"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "license": "MIT",
  "author": "Jair Torres",
  "version": "3.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JairTorres1003/eslint-plugin-sensitive-env.git"
  },
  "bugs": {
    "url": "https://github.com/JairTorres1003/eslint-plugin-sensitive-env/issues"
  },
  "homepage": "https://github.com/JairTorres1003/eslint-plugin-sensitive-env#readme",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --cache",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,cjs}\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml,cjs}\"",
    "build": "tsc -p ./ && tsc-alias",
    "watch": "concurrently \"tsc -w -p ./\" \"tsc-alias -w\"",
    "test": "jest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@typescript-eslint/rule-tester": "^8.24.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint-config-love": "^118.0.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "peerDependencies": {
    "dotenv": "^16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
